{
  "name": "@dorigjo/besa",
  "version": "1.1.0",
  "description": "Cryptographic admission and evidence for consequential AI-agent actions.",
  "type": "module",
  "main": "./dist/sdk.js",
  "types": "./dist/sdk.d.ts",
  "exports": {
    ".": {
      "types": "./dist/sdk.d.ts",
      "default": "./dist/sdk.js"
    }
  },
  "bin": {
    "besa": "dist/index.js"
  },
  "scripts": {
    "build": "tsc",
    "test": "npm run build && node dist/tests/run.js",
    "conformance": "npm run build && node --test dist/tests/golden.test.js dist/tests/conformance-v11.test.js",
    "demo": "npm run build && node dist/demo.js",
    "benchmark": "npm run build && node dist/benchmark.js",
    "test:examples": "tsc -p tsconfig.examples.json",
    "test:docs": "node scripts/docs-receipt-check.mjs",
    "smoke": "node scripts/smoke.mjs",
    "smoke:server": "node scripts/server-smoke.mjs",
    "test:package": "node scripts/package-smoke.mjs",
    "sbom": "npm sbom --sbom-format=cyclonedx",
    "verify:package-surface": "node scripts/verify-package-surface.mjs",
    "prepack": "npm run build"
  },
  "keywords": [
    "mcp",
    "ai-agents",
    "agent-security",
    "action-admission",
    "mcp-security",
    "trust",
    "execution-evidence",
    "audit-readiness",
    "ed25519",
    "signing",
    "manifest",
    "receipt",
    "attestation"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/dorigjo/besa.git"
  },
  "author": "dorigjo",
  "license": "MIT",
  "dependencies": {
    "yaml": "^2.5.1"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "typescript": "^5.6.2"
  },
  "engines": {
    "node": ">=20"
  },
  "files": [
    "dist/*.js",
    "dist/*.d.ts",
    "dist/keys/*.js",
    "dist/keys/*.d.ts",
    "dist/server/*.js",
    "dist/server/*.d.ts",
    "examples/manifest.yaml",
    "examples/grants.yaml",
    "examples/request.json",
    "examples/action-policy.yaml",
    "examples/consequential-mcp-middleware.ts",
    "examples/hosted-verifier.env.example",
    "Dockerfile",
    "ARCHITECTURE.md",
    "AUDIT_SCOPE.md",
    "CONTRIBUTING.md",
    "SECURITY.md",
    "SPEC.md",
    "docs/AGENT_GATEWAY.md",
    "docs/BENCHMARKS.md",
    "docs/EVIDENCE_ENVELOPE.md",
    "docs/HOSTED_VERIFIER.md",
    "docs/RUNTIME_ADMISSION.md",
    "docs/THREAT_MODEL.md",
    "docs/V1_1_SECURITY_REVIEW.md",
    "docs/launch/*.md",
    "conformance/golden-v1.json",
    "conformance/consequential-action-v1.json",
    "conformance/consequential-action-negative-v1.json"
  ],
  "bugs": {
    "url": "https://github.com/dorigjo/besa/issues"
  },
  "homepage": "https://github.com/dorigjo/besa#readme"
}
