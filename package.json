{
  "name": "@dorigjo/besa",
  "version": "1.0.1",
  "description": "Cryptographic execution evidence for AI-agent tool calls: signed manifests, admission decisions, and tamper-evident receipts.",
  "type": "module",
  "main": "./dist/sdk.js",
  "types": "./dist/sdk.d.ts",
  "exports": {
    ".": {
      "types": "./dist/sdk.d.ts",
      "default": "./dist/sdk.js"
    }
  },
  "bin": {
    "besa": "dist/index.js"
  },
  "scripts": {
    "build": "tsc",
    "test": "npm run build && node dist/tests/run.js",
    "test:examples": "tsc -p tsconfig.examples.json",
    "test:docs": "node scripts/docs-receipt-check.mjs",
    "smoke": "node scripts/smoke.mjs",
    "smoke:server": "node scripts/server-smoke.mjs",
    "test:package": "node scripts/package-smoke.mjs",
    "sbom": "npm sbom --sbom-format=cyclonedx",
    "verify:package-surface": "node scripts/verify-package-surface.mjs",
    "prepack": "npm run build"
  },
  "keywords": [
    "mcp",
    "ai-agents",
    "agent-security",
    "trust",
    "execution-evidence",
    "audit-readiness",
    "ed25519",
    "signing",
    "manifest",
    "receipt",
    "attestation"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/dorigjo/besa.git"
  },
  "author": "dorigjo",
  "license": "MIT",
  "dependencies": {
    "yaml": "^2.5.1"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "typescript": "^5.6.2"
  },
  "engines": {
    "node": ">=20"
  },
  "files": [
    "dist/*.js",
    "dist/*.d.ts",
    "dist/keys/*.js",
    "dist/keys/*.d.ts",
    "dist/server/*.js",
    "dist/server/*.d.ts",
    "examples/manifest.yaml",
    "examples/grants.yaml",
    "examples/request.json",
    "SPEC.md",
    "conformance/golden-v1.json"
  ],
  "bugs": {
    "url": "https://github.com/dorigjo/besa/issues"
  },
  "homepage": "https://github.com/dorigjo/besa#readme"
}
