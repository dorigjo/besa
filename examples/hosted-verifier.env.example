# This file is a reference only. Besa does not load .env files itself.
# Keep real values in your deployment platform's secret store, never in Git.

# Required only when enabling --trust and --action-policy. It decrypts the
# pre-provisioned Ed25519 signing key mounted at /app/.besa/key.json.
BESA_KEY_PASSPHRASE=replace-with-a-unique-secret-of-at-least-16-utf8-bytes

# Required whenever --trust enables either legacy or consequential admission.
# Use a high-entropy bearer token and rotate it through your secret manager.
BESA_ADMISSION_TOKEN=replace-with-a-high-entropy-bearer-token

# Optional stable issuer label embedded in action capabilities.
BESA_ADMISSION_ISSUER_ID=besa:hosted-verifier
