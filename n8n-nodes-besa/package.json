{
  "name": "n8n-nodes-besa",
  "version": "0.1.1",
  "description": "Verify signed BESA manifests, gate tool calls through BESA admission policy, and issue signed BESA execution receipts from an n8n workflow.",
  "license": "MIT",
  "homepage": "https://github.com/dorigjo/besa/tree/main/n8n-nodes-besa#readme",
  "keywords": [
    "n8n-community-node-package",
    "besa",
    "trust",
    "ed25519",
    "signing",
    "admission",
    "receipt",
    "ai-agents"
  ],
  "author": {
    "name": "dorigjo",
    "email": "dorigjo@users.noreply.github.com"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/dorigjo/besa.git",
    "directory": "n8n-nodes-besa"
  },
  "bugs": {
    "url": "https://github.com/dorigjo/besa/issues"
  },
  "engines": {
    "node": ">=20"
  },
  "files": [
    "dist",
    "examples",
    "TESTER.md"
  ],
  "n8n": {
    "n8nNodesApiVersion": 1,
    "credentials": [
      "dist/credentials/BesaSigningKeyApi.credentials.js"
    ],
    "nodes": [
      "dist/nodes/Besa/Besa.node.js"
    ],
    "strict": false
  },
  "scripts": {
    "build": "n8n-node build && node scripts/bundle.mjs",
    "dev": "n8n-node dev",
    "lint": "n8n-node lint",
    "lint:fix": "n8n-node lint --fix",
    "test": "npm run build && node --test",
    "pack:check": "npm pack --dry-run"
  },
  "devDependencies": {
    "@dorigjo/besa": "1.3.0",
    "@n8n/node-cli": "^0.43.3",
    "@types/node": "^24.0.0",
    "esbuild": "^0.28.2",
    "n8n-workflow": "^2.16.0",
    "typescript": "^5.9.3"
  },
  "peerDependencies": {
    "n8n-workflow": "*"
  }
}
